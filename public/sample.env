# AERO BYOK setup sample
# Copy this file, fill in the values, then import it from Setup & AI.
# Never commit a real .env file or share your service-account private key.

AI_PROVIDER=vertex-ai
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-2.5-flash

# Put the complete Google Cloud service-account JSON file into a base64 string.
# PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes('service-account.json'))
# macOS/Linux: base64 -i service-account.json | tr -d '\n'
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# For an OpenAI-compatible provider, switch AI_PROVIDER and fill these instead.
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=replace-with-your-provider-key
# AI_MODEL=gpt-4o-mini
